# Buggies For Sale: environment variables. Set these in Vercel > Project > Settings > Environment Variables, never in the repo.

# --- Reply portal and storage
ADMIN_PASSCODE=           # passcode for /admin (orders, enquiries, email test, keyword report)
# Connect an Upstash Redis database from Vercel > Storage; it adds KV_REST_API_URL and KV_REST_API_TOKEN automatically.

# --- Email: Zoho Mail over SMTP. Orders and enquiries are delivered to your Zoho mailbox.
# Zoho Workplace (custom domain, paid):  smtppro.zoho.com  (AU data centre: smtppro.zoho.com.au, EU: smtppro.zoho.eu)
# Zoho Mail free plan:                   smtp.zoho.com     (AU: smtp.zoho.com.au)
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465             # 465 = SSL, or 587 = STARTTLS
SMTP_USER=sales@buggiesforsale.com.au      # the full Zoho mailbox that sends the mail
SMTP_PASS=                # Zoho application-specific password (Zoho Accounts > Security > App Passwords), not your normal login password
# SMTP_FROM="Buggies For Sale <sales@buggiesforsale.com.au>"   # optional; Zoho only accepts the mailbox itself or a send-as alias

# Where notifications go (all optional, default sales@buggiesforsale.com.au)
# ORDER_EMAIL=
# CONTACT_EMAIL=
# WHOLESALE_EMAIL=

# --- Site
# NEXT_PUBLIC_SITE_URL=https://buggiesforsale.com.au

# --- Deliverability (DNS at your domain host; this is the real spam fix)
# SPF:   TXT @       "v=spf1 include:zoho.com ~all"     (AU data centre: include:zoho.com.au)
# DKIM:  Zoho Mail Admin > Domains > Email Configuration > DKIM, add the TXT record it shows
# DMARC: TXT _dmarc  "v=DMARC1; p=quarantine; rua=mailto:sales@buggiesforsale.com.au"
